# Postgres connection string (Azure Database for PostgreSQL Flexible Server in prod)
DATABASE_URL="postgresql://user:password@localhost:5432/abouna_qa?sslmode=prefer"

# Azure Communication Services Email connection string
ACS_CONNECTION_STRING="endpoint=https://<resource>.communication.azure.com/;accesskey=<key>"
# Sender address provisioned on the ACS Email domain (managed subdomain or verified custom domain)
EMAIL_FROM_ADDRESS="DoNotReply@<your-acs-domain>.azurecomm.net"

# 32+ byte random string used to encrypt session cookies (iron-session)
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Base URL used to build links in emails (no trailing slash)
PUBLIC_BASE_URL="http://localhost:3000"

# Consumed once by prisma/seed.ts to create the first admin priest; not read at runtime
ADMIN_SEED_EMAIL="priest@example.com"
ADMIN_SEED_NAME="Fr. Example"
